{
  "name": "multrillion",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --mode offline",
    "dev:ai": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run check-data && vite build && wrangler deploy",
    "check-data": "tsx scripts/check-data.ts",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
