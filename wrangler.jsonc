{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multrillion",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  // Workers AI, used as a lenient fallback when the rule-based matcher doesn't recognise an answer.
  "ai": { "binding": "AI" },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Set to "off" to disable the AI fallback (e.g. in local dev without a Cloudflare login).
    "AI_FALLBACK": "on"
  },
  "observability": { "enabled": true }
}
